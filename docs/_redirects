# MyDrivingCost.com — fallback redirect table
# Netlify reads netlify.toml first; this file covers Cloudflare Pages and any
# host that understands the _redirects format. Rules are evaluated top to bottom.
#
# Two rules. First, the apex is canonical — www must not resolve on its own or
# a crawler sees the whole site twice. Second, no URL on this site ends in
# .html; legacy extensions are permanently redirected to the clean, slash-
# terminated canonical path.

https://www.mydrivingcost.com/*        https://mydrivingcost.com/:splat   301!
http://www.mydrivingcost.com/*         https://mydrivingcost.com/:splat   301!

/index.html                            /                                  301!
/calculators/true-cost-to-own.html     /calculators/true-cost-to-own/     301!
/calculators/lease-vs-buy.html         /calculators/lease-vs-buy/         301!
/about.html                            /about/                            301!

/:page.html                            /:page/                            301!
/:dir/:page.html                       /:dir/:page/                       301!
/:dir/:sub/:page.html                  /:dir/:sub/:page/                  301!

/*                                     /404.html                          404
